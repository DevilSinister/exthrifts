# Copy to .env (local) or set in Hostinger hPanel (production). Never commit real values.

# --- Store identity -----------------------------------------------------------
# Shown in titles, the announcement bar, slips, push alerts and JSON-LD.
NEXT_PUBLIC_SITE_NAME="ExThrifts"
# Public origin, no trailing slash. Used for canonical URLs, sitemap, the admin
# origin check and the Android app's deep links.
NEXT_PUBLIC_SITE_URL="https://exthrifts.com"
# Order numbers are shown as <PREFIX>-<1000 + n>, e.g. EXT-1001.
NEXT_PUBLIC_ORDER_PREFIX="EXT"

# --- Database (MySQL / MariaDB) ---------------------------------------------
# Local: matches docker-compose.yml. Production: the Hostinger MySQL database.
DATABASE_URL="mysql://exthrifts:exthrifts_local@127.0.0.1:3307/exthrifts"

# --- Admin sessions -----------------------------------------------------------
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# First owner account, created by `npm run db:seed` if no owner exists yet.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
# Local demo only (npm run db:demo): a STAFF login for testing role limits.
SEED_STAFF_EMAIL=""
SEED_STAFF_PASSWORD=""

# --- Uploads ------------------------------------------------------------------
# Absolute folder OUTSIDE the app directory so a redeploy never wipes photos.
# Local default (unset) is ./uploads. Hostinger example: /home/<user>/exthrifts-uploads
UPLOAD_DIR=""

# --- Order alerts (Android app, Firebase Cloud Messaging) --------------------
# The whole service-account JSON on one line (Firebase console > Project
# settings > Service accounts > Generate new private key). Empty = alerts off.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# 16+ random characters; the hPanel cron sends it to /api/cron/push.
CRON_SECRET=""
