<?xml version="1.0" encoding="utf-8"?>
<!-- The website's solid ink button: square corners, ink fill, a ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_ink">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><solid android:color="@color/muted"/></shape>
            </item>
            <item>
                <shape><solid android:color="@color/ink"/></shape>
            </item>
        </selector>
    </item>
</ripple>
